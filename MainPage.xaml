<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="stocklily.MainPage">

    <StackLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        
        <!-- Top Content -->
        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
            <Image Source="your_image.png" HeightRequest="100" WidthRequest="0" />
            <Label Text="Welcome, please login" FontSize="Header" HorizontalOptions="Center" Margin="10"/>
        </StackLayout>
        
        <!-- Center Buttons -->
        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="100" Padding="20" Spacing="20">
            <Button Text="Sign Up" Clicked="SignUpButton_Clicked"/>
            <Button Text="Sign In" Clicked="SignInButton_Clicked"/>
        </StackLayout>



    </StackLayout>

</ContentPage>
